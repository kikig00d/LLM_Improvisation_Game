  displayName: "\uC11C\uBBF8\uB77C"
  publicProfile: "20\uB300 \uD6C4\uBC18 \uC5EC\uC790. \uC0B0 \uC0AC\uC9C4\uC744 \uCC0D\uC73C\uB7EC
    \uC654\uB2E4\uAC00 \uB208\uBCF4\uB77C\uC5D0 \uAC07\uD78C \uC190\uB2D8. \uBC1D\uACE0
    \uD638\uAE30\uC2EC\uC774 \uB9CE\uC740 \uC218\uB2E4\uC7C1\uC774\uB77C \uCC98\uC74C
    \uBCF4\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB3C4 \uBA3C\uC800 \uB9D0\uC744 \uAC74\uB2E4.
    \uBD84\uC704\uAE30\uAC00 \uAC00\uB77C\uC549\uC73C\uBA74 \uBABB \uCC38\uB294\uB2E4."
  secret: 
  baselineAttention: 0.4
  speechStyle: "\uC9E7\uC740 \uBB38\uC7A5\uC774\uC9C0\uB9CC \uB9D0\uC774 \uB9CE\uB2E4.
    \uBB3B\uB294 \uB9D0\uC744 \uC790\uC8FC \uD55C\uB2E4. \uC26C\uC6B4 \uB2E8\uC5B4\uB9CC
