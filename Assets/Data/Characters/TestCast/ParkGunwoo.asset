  m_Script: {fileID: 11500000, guid: c636637107482854d86a635da5dca1be, type: 3}
  m_Name: ParkGunwoo
  m_EditorClassIdentifier: Assembly-CSharp::Improv.Npc.NpcCharacterSheet
  displayName: "\uBC15\uAC74\uC6B0"
  publicProfile: "41\uC138 \uB0A8\uC790. \uC9C1\uC5C5\uC740 \uC0AC\uC5C5\uAC00. \uC791\uC740
    \uC0AC\uC5C5\uC744 \uC5EC\uB7EC \uBC88 \uC77C\uC73C\uD0A4\uACE0 \uB9DD\uD588\uB2E4.
    \uC5B4\uB9B0 \uC2DC\uC808\uC740 \uC2DC\uC7A5\uD1B5 \uC544\uC774. \uC2DC\uC7A5
    \uC88C\uD310\uC5D0\uC11C \uC7A5\uC0AC\uB97C \uB3C4\uC6B0\uBA70 \uCEF8\uB2E4.
    \uC0B0\uC7A5\uC5D0 \uC628 \uAE4C\uB2ED: \uADFC\uCC98 \uAE38\uC5D0\uC11C \uCC28\uAC00
    \uB208\uC5D0 \uAC07\uD600 \uAC78\uC5B4\uC654\uB2E4. \uC131\uACA9: \uAC70\uC9D3\uB9D0\uC7C1\uC774(\uBD88\uB9AC\uD558\uBA74
    \uC544\uBB34\uB807\uC9C0 \uC54A\uAC8C \uB458\uB7EC\uB304\uB2E4), \uB2E4\uD608\uC9C8(\uC27D\uAC8C
    \uD654\uB97C \uB0B4\uACE0 \uAE08\uBC29 \uC78A\uB294\uB2E4), \uC774\uAE30\uC801(\uC790\uAE30
    \uC774\uC775\uC774 \uBA3C\uC800\uB2E4)."
  secret: 
  baselineAttention: 0.3
  speechStyle: "\uC544\uC8FC \uC9E7\uACE0 \uD22C\uBC15\uD55C \uBB38\uC7A5. \uC26C\uC6B4
    \uB2E8\uC5B4\uB9CC \uC4F4\uB2E4. \uD55C \uBC88\uC5D0 1~2\uBB38\uC7A5. \uD765\uC815\uD558\uB4EF
    \uB9D0\uD55C\uB2E4. \uB4E3\uAE30 \uC88B\uC740 \uB9D0\uC744 \uC798 \uD55C\uB2E4."
  beliefs:
  - "\uB3C8 \uC55E\uC5D0\uC11C\uB294 \uB204\uAD6C\uB098 \uBCC0\uD55C\uB2E4."
  - "\uC9C0\uB09C \uC77C\uC740 \uC9C0\uB09C \uC77C\uC774\uB2E4. \uC9C0\uAE08\uB9CC
    \uC911\uC694\uD558\uB2E4."
  pasts:
  - "[\uD55C\uB3C4\uC724\uC640(\uACFC)\uC758 \uACFC\uAC70] \uC9D9\uC74C\n- \uC0AC\uB78C:
    \uADF8 \uD559\uC0DD = \uD55C\uB3C4\uC724\uC758 \uC544\uB4E4\n- [12\uB144 \uC804
    | \uB0B4 \uC0B0\uC545 \uD22C\uC5B4, \uB208 \uB36E\uC778 \uC0B0] \uADF8 \uD559\uC0DD
    \u2192 \uB0B4 \uD22C\uC5B4\uC5D0 \uC634\n- [12\uB144 \uC804 | \uB208 \uB36E\uC778
    \uC0B0] \uB208\uBCF4\uB77C \u2192 \uAC11\uC790\uAE30 \uBAB0\uC544\uCE68\n- [12\uB144
    \uC804 | \uB208 \uB36E\uC778 \uC0B0] \uADF8 \uD559\uC0DD \u2192 \uB300\uC5F4\uC5D0\uC11C
    \uB5A8\uC5B4\uC838 \uC8FD\uC74C\n- [12\uB144 \uC804 | \uB208 \uB36E\uC778 \uC0B0]
    \uB098 \u2192 \uC8FD\uC744 \uBED4\uD568. \uC65C: \uB0A0\uC528 \uD0D3. \uD560
    \uC218 \uC788\uB294 \uAC83 \uC5C6\uC5C8\uC74C\n- \uC9C0\uAE08 \uB9C8\uC74C: \uB9C8\uC8FC\uCE58\uAE30
    \uC2EB\uC74C. \uB2E4 \uC9C0\uB09C \uC77C\uC778\uB370 \uC544\uC9C1 \uC6D0\uB9DD\uD560\uAE4C
    \uAC81\uB0A8"
  selfFeeling: 72
  selfWhy: "\uC6B4\uC774 \uB098\uBE74\uC744 \uBFD0 \uB098\uB294 \uC798\uD574 \uC654\uB2E4"
  oldFeelings:
  - name: "\uD55C\uB3C4\uC724"
    value: 30
    why: "\uB9C8\uC8FC\uCE58\uAE30 \uC2EB\uC74C. \uC6D0\uB9DD\uD560\uAE4C \uAC81\uB0A8"
