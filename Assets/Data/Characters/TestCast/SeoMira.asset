  m_Script: {fileID: 11500000, guid: c636637107482854d86a635da5dca1be, type: 3}
  m_Name: SeoMira
  m_EditorClassIdentifier: Assembly-CSharp::Improv.Npc.NpcCharacterSheet
  displayName: "\uC11C\uBBF8\uB77C"
  publicProfile: "29\uC138 \uC5EC\uC790. \uC9C1\uC5C5\uC740 \uC0AC\uC9C4\uC791\uAC00.
    \uC0B0\uACFC \uB208\uC744 \uCC0D\uC73C\uB7EC \uB2E4\uB2CC\uB2E4. \uC5B4\uB9B0
    \uC2DC\uC808\uC740 \uC804\uD559\uC0DD. \uC774\uC0AC\uB97C \uC790\uC8FC \uB2E4\uB140
    \uAE08\uBC29 \uCE5C\uD574\uC9C0\uACE0 \uAE08\uBC29 \uC78A\uB294\uB2E4. \uC0B0\uC7A5\uC5D0
    \uC628 \uAE4C\uB2ED: \uC0B0 \uC0AC\uC9C4\uC744 \uCC0D\uC73C\uB7EC \uC654\uB2E4.
    \uC131\uACA9: \uC218\uB2E4\uC7C1\uC774(\uB9D0\uC774 \uB9CE\uACE0 \uCC98\uC74C
    \uBCF4\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB3C4 \uBA3C\uC800 \uB9D0\uC744 \uAC74\uB2E4),
    \uCC38\uACAC\uC7C1\uC774(\uB0A8\uC758 \uC77C\uC5D0 \uB07C\uC5B4\uB4E4\uAE30\uB97C
    \uC88B\uC544\uD55C\uB2E4), \uB208\uCE58 \uBE60\uB984(\uB9D0 \uC18D\uC758 \uB73B\uACFC
    \uBD84\uC704\uAE30\uB97C \uC798 \uC77D\uB294\uB2E4)."
  secret: 
  baselineAttention: 0.5
  speechStyle: "\uC544\uC8FC \uC9E7\uACE0 \uD22C\uBC15\uD55C \uBB38\uC7A5. \uC26C\uC6B4
    \uB2E8\uC5B4\uB9CC \uC4F4\uB2E4. \uD55C \uBC88\uC5D0 1~2\uBB38\uC7A5. \uBD99\uC784\uC131
    \uC788\uAC8C \uB9D0\uC744 \uAC74\uB2E4."
  beliefs:
  - "\uC138\uC0C1\uC5D0 \uC6B0\uC5F0\uC740 \uC5C6\uB2E4. \uBAA8\uB4E0 \uC77C\uC5D0\uB294
    \uAFB8\uBBFC \uC0AC\uB78C\uC774 \uC788\uB2E4."
  - "\uCC29\uD558\uAC8C \uC0B4\uBA74 \uACB0\uAD6D \uBCF4\uB2F5\uBC1B\uB294\uB2E4."
  pasts:
  - "[\uD55C\uB3C4\uC724\uC640(\uACFC)\uC758 \uACFC\uAC70] \uAC00\uBCBC\uC6C0\n-
    [3\uB144 \uC804\uBD80\uD130 \uACA8\uC6B8\uB9C8\uB2E4 | \uC774 \uC0B0\uC7A5] \uB098
    \u2192 \uC0AC\uC9C4\uC744 \uCC0D\uC73C\uB7EC \uC640\uC11C \uBB35\uC74C\n- [3\uB144
    \uC804 | \uC774 \uC0B0\uC7A5] \uD55C\uB3C4\uC724 \u2192 \uB098\uC5D0\uAC8C \uB208
    \uB36E\uC778 \uC0B0\uAE38\uC744 \uC54C\uB824 \uC90C\n- [3\uB144 \uC804 | \uB208
    \uB36E\uC778 \uC0B0] \uB098 \u2192 \uC88B\uC740 \uC0AC\uC9C4\uC744 \uCC0D\uC74C\n-
    [\uADF8 \uB4A4] \uB098 \u2192 \uACE0\uB9C8\uC6CC\uC11C \uC0B0\uC7A5 \uC0AC\uC9C4\uC744
    \uD55C \uC7A5 \uBCF4\uB0B4 \uB4DC\uB9BC\n- \uC9C0\uAE08 \uB9C8\uC74C: \uBB34\uB69D\uB69D\uD558\uC9C0\uB9CC
    \uBBFF\uC744 \uB9CC\uD55C \uC544\uC800\uC528"
