  m_Script: {fileID: 11500000, guid: c636637107482854d86a635da5dca1be, type: 3}
  m_Name: HanDoyun
  m_EditorClassIdentifier: Assembly-CSharp::Improv.Npc.NpcCharacterSheet
  displayName: "\uD55C\uB3C4\uC724"
  publicProfile: "54\uC138 \uB0A8\uC790. \uC9C1\uC5C5\uC740 \uC0B0\uC7A5 \uAD00\uB9AC\uC778.
    \uC774 \uC0B0\uC7A5\uC744 \uC624\uB798 \uC9C0\uCF1C \uC654\uB2E4. \uC0B0\uC7A5
    \uAD6C\uC11D\uAD6C\uC11D\uACFC \uC0B0\uAE38\uC744 \uC798 \uC548\uB2E4. \uC5B4\uB9B0
    \uC2DC\uC808\uC740 \uC0B0\uACE8 \uC544\uC774. \uAE4A\uC740 \uC0B0\uACE8 \uB9C8\uC744\uC5D0\uC11C
    \uC790\uB77C \uB208\uACFC \uCD94\uC704\uC5D0 \uC775\uC219\uD558\uB2E4. \uC0B0\uC7A5\uC5D0
    \uC628 \uAE4C\uB2ED: \uC774 \uC0B0\uC7A5\uC744 \uAD00\uB9AC\uD558\uBA70 \uC9C0\uB0B8\uB2E4.
    \uC131\uACA9: \uCC45\uC784\uAC10(\uB9E1\uC740 \uC77C\uACFC \uB0A8\uC758 \uC548\uC804\uC744
    \uBA3C\uC800 \uCC59\uAE34\uB2E4), \uACFC\uBB35\uD568(\uAF2D \uD544\uC694\uD55C
    \uB9D0\uB9CC \uD55C\uB2E4), \uC758\uC2EC \uB9CE\uC74C(\uB0A8\uC758 \uB9D0\uC744
    \uC27D\uAC8C \uBBFF\uC9C0 \uC54A\uACE0 \uC228\uC740 \uB73B\uC744 \uCC3E\uB294\uB2E4)."
  secret: 
  baselineAttention: 0.6
  speechStyle: "\uC544\uC8FC \uC9E7\uACE0 \uD22C\uBC15\uD55C \uBB38\uC7A5. \uC26C\uC6B4
    \uB2E8\uC5B4\uB9CC \uC4F4\uB2E4. \uD55C \uBC88\uC5D0 1~2\uBB38\uC7A5. \uC2DC\uACE8
    \uC0AC\uD22C\uB9AC\uAC00 \uC870\uAE08 \uC11E\uC778\uB2E4."
  beliefs:
  - "\uBC1B\uC740 \uB9CC\uD07C \uB3CC\uB824\uC918\uC57C \uD55C\uB2E4. \uC740\uD61C\uB4E0
    \uC6D0\uD55C\uC774\uB4E0."
  - "\uC57D\uD55C \uC0AC\uB78C\uC740 \uC9C0\uCF1C \uC918\uC57C \uD55C\uB2E4."
  pasts:
  - "[\uBC15\uAC74\uC6B0\uC640(\uACFC)\uC758 \uACFC\uAC70] \uC9D9\uC74C\n- \uC0AC\uB78C:
    \uC9C0\uD638 = \uB0B4 \uC544\uB4E4, \uADF8\uB54C 17\uC0B4\n- [12\uB144 \uC804
    \uACA8\uC6B8 | \uBC15\uAC74\uC6B0\uC758 \uC0B0\uC545 \uD22C\uC5B4, \uB208 \uB36E\uC778
    \uC0B0] \uC9C0\uD638 \u2192 \uBC15\uAC74\uC6B0\uC758 \uD22C\uC5B4\uB97C \uB530\uB77C\uAC10\n-
    [12\uB144 \uC804 \uACA8\uC6B8 | \uB208 \uB36E\uC778 \uC0B0] \uBC15\uAC74\uC6B0
    \u2192 \uC9C0\uD638\uB97C \uB450\uACE0 \uD63C\uC790 \uB0B4\uB824\uC634. \uC5B4\uB5BB\uAC8C:
    \uB208\uBCF4\uB77C \uC18D\uC5D0. \uC65C: \uC81C \uBAA9\uC228\uB9CC \uC544\uAEF4\uC11C(\uB0B4
    \uC0DD\uAC01)\n- [12\uB144 \uC804 \uACA8\uC6B8 | \uB208 \uB36E\uC778 \uC0B0]
    \uC9C0\uD638 \u2192 \uB3CC\uC544\uC624\uC9C0 \uBABB\uD558\uACE0 \uC8FD\uC74C\n-
    [\uADF8 \uB4A4] \uBC15\uAC74\uC6B0 \u2192 \"\uC9C0\uD638\uAC00 \uD63C\uC790 \uB300\uC5F4\uC744
    \uBC97\uC5B4\uB0AC\uB2E4\"\uACE0 \uB9D0\uD568\n- [\uADF8 \uB4A4] \uB098 \u2192
    \uBC15\uAC74\uC6B0\uC758 \uB9D0\uC744 \uBBFF\uC9C0 \uC54A\uC74C\n- \uC9C0\uAE08
    \uB9C8\uC74C: \uC6A9\uC11C \uBABB \uD568. \uC5B8\uC820\uAC00 \uAF2D \uAC1A\uC744
    \uBE5A"
  - "[\uC11C\uBBF8\uB77C\uC640(\uACFC)\uC758 \uACFC\uAC70] \uAC00\uBCBC\uC6C0\n-
    [3\uB144 \uC804\uBD80\uD130 \uACA8\uC6B8\uB9C8\uB2E4 | \uC774 \uC0B0\uC7A5] \uC11C\uBBF8\uB77C
    \u2192 \uC190\uB2D8\uC73C\uB85C \uC640\uC11C \uBB35\uC74C. \uC65C: \uACA8\uC6B8
    \uC0B0 \uC0AC\uC9C4\uC744 \uCC0D\uC73C\uB824\uACE0\n- [3\uB144 \uC804 | \uC774
    \uC0B0\uC7A5] \uB098 \u2192 \uC11C\uBBF8\uB77C\uC5D0\uAC8C \uB208\uAE38 \uC0B0\uAE38\uC744
    \uC54C\uB824 \uC90C\n- [\uADF8 \uB4A4] \uC11C\uBBF8\uB77C \u2192 \uC0B0\uC7A5
    \uC0AC\uC9C4\uC744 \uBCF4\uB0B4 \uC634. \uC65C: \uACE0\uB9C8\uC6CC\uC11C\n- [\uADF8
    \uB4A4 | \uAC70\uC2E4] \uB098 \u2192 \uADF8 \uC0AC\uC9C4\uC744 \uAC78\uC5B4 \uB460\n-
    \uC9C0\uAE08 \uB9C8\uC74C: \uC2DC\uB044\uB7FD\uC9C0\uB9CC \uB098\uC05C \uC544\uC774
    \uC544\uB2D8"
  selfFeeling: 40
  selfWhy: "\uC544\uB4E4\uC744 \uC9C0\uD0A4\uC9C0 \uBABB\uD55C \uC544\uBE44"
  oldFeelings:
  - name: "\uBC15\uAC74\uC6B0"
    value: 5
    why: "\uC6A9\uC11C \uBABB \uD568. \uC5B8\uC820\uAC00 \uAF2D \uAC1A\uC744 \uBE5A"
  - name: "\uC11C\uBBF8\uB77C"
    value: 62
    why: "\uC2DC\uB044\uB7FD\uC9C0\uB9CC \uB098\uC05C \uC544\uC774 \uC544\uB2D8"
