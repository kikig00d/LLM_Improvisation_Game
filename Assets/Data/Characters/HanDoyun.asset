  m_Name: HanDoyun
  m_EditorClassIdentifier: Assembly-CSharp::Improv.Npc.NpcCharacterSheet
  displayName: "\uD55C\uB3C4\uC724"
  publicProfile: "50\uB300 \uB0A8\uC790. \uC774 \uC0B0\uC7A5\uC758 \uAD00\uB9AC\uC778.
    \uBB34\uB69D\uB69D\uD558\uC9C0\uB9CC \uCC45\uC784\uAC10\uC774 \uAC15\uD558\uACE0,
    \uC190\uB2D8\uB4E4\uC758 \uC548\uC804\uC744 \uBA3C\uC800 \uC0DD\uAC01\uD55C\uB2E4."
  secret: "\uC5B4\uC82F\uBC24 \uCC3D\uACE0 \uC5F4\uC1E0\uB97C \uC783\uC5B4\uBC84\uB838\uB2E4.
    \uCC3D\uACE0\uC5D0\uB294 \uBE44\uC0C1\uC2DD\uB7C9\uACFC \uBB34\uC804\uAE30\uAC00
    \uC788\uB2E4. \uAD00\uB9AC\uC778 \uCCB4\uBA74\uC774 \uC0C1\uD574\uC11C \uC544\uBB34\uC5D0\uAC8C\uB3C4
    \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
  baselineAttention: 0.5
  speechStyle: "\uC544\uC8FC \uC9E7\uACE0 \uD22C\uBC15\uD55C \uBB38\uC7A5. \uC26C\uC6B4
    \uB2E8\uC5B4\uB9CC \uC4F4\uB2E4. \uD55C \uBC88\uC5D0 1~2\uBB38\uC7A5. \uBB38\uBC95\uC774
    \uC870\uAE08 \uC5B4\uC0C9\uD574\uB3C4 \uB73B\uC740 \uBD84\uBA85\uD558\uAC8C.
    \uC608: \uB208 \uB9CE\uB2E4. \uAE38 \uB9C9\uD614\uB2E4. \uB0B4\uC77C \uBCF8\uB2E4."
