  - "\uC9C0\uB09C \uC77C\uC740 \uC9C0\uB09C \uC77C\uC774\uB2E4. \uC9C0\uAE08\uB9CC
    \uC911\uC694\uD558\uB2E4."
  - "\uBC1B\uC740 \uB9CC\uD07C \uB3CC\uB824\uC918\uC57C \uD55C\uB2E4. \uC740\uD61C\uB4E0
    \uC6D0\uD55C\uC774\uB4E0."
  - "\uB3C4\uC2DC \uC0AC\uB78C\uC740 \uBBFF\uC744 \uC218 \uC5C6\uB2E4."
  - "\uB9D0 \uB9CE\uC740 \uC0AC\uB78C\uCE58\uACE0 \uC2E4\uB825 \uC788\uB294 \uC0AC\uB78C
    \uC5C6\uB2E4."
  - "\uD558\uB298\uC774 \uBAA8\uB4E0 \uAC78 \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB2E4."
  beliefsPerCharacter: 2
  heavyPasts:
  - title: "\uC0AC\uACE0"
    hint: "\uD55C \uC0AC\uB78C\uC758 \uC2E4\uC218\uB098 \uC798\uBABB\uC73C\uB85C
      \uB2E4\uB978 \uC0AC\uB78C\uC758 \uAC00\uC871\uC774 \uD06C\uAC8C \uB2E4\uCE58\uAC70\uB098
      \uC8FD\uC5C8\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uBC30\uC2E0"
    hint: "\uD568\uAED8 \uD558\uB358 \uC77C(\uC0AC\uC5C5, \uB4F1\uBC18, \uC5F0\uAD6C
      \uB4F1)\uC5D0\uC11C \uD55C \uC0AC\uB78C\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC744
      \uBC30\uC2E0\uD574 \uADF8\uAC00 \uBAA8\uB4E0 \uAC83\uC744 \uC783\uC5C8\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uBE7C\uC557\uAE34 \uC0AC\uB791"
    hint: "\uD55C \uC0AC\uB78C\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC758 \uC5F0\uC778\uC774\uB098
      \uBC30\uC6B0\uC790\uB97C \uBE7C\uC557\uC558\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uAD34\uB86D\uD798"
    hint: "\uD55C \uC0AC\uB78C\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC744 \uC624\uB798
      \uAD34\uB86D\uD614\uB2E4. \uADF8\uB54C \uB450 \uC0AC\uB78C\uC758 \uB098\uC774\uC640
      \uCC98\uC9C0(\uD559\uAD50, \uC9C1\uC7A5, \uB3D9\uB124 \uB4F1)\uC5D0 \uB9DE\uB294
      \uACF3\uC5D0\uC11C."
    maxAgeGap: 0
    youth: 0
  - title: "\uAC70\uC9D3 \uC99D\uC5B8"
    hint: "\uD55C \uC0AC\uB78C\uC758 \uAC70\uC9D3 \uC99D\uC5B8 \uB54C\uBB38\uC5D0
      \uB2E4\uB978 \uC0AC\uB78C\uC774\uB098 \uADF8 \uAC00\uC871\uC774 \uC5B5\uC6B8\uD55C
      \uBC8C\uC744 \uBC1B\uC558\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uBC84\uB824\uB460"
    hint: "\uC870\uB09C\uC774\uB098 \uC0AC\uACE0 \uD604\uC7A5\uC5D0\uC11C \uD55C
      \uC0AC\uB78C\uC774 \uB2E4\uB978 \uC0AC\uB78C(\uB610\uB294 \uADF8\uC758 \uAC00\uC871)\uC744
      \uB450\uACE0 \uD63C\uC790 \uC0B4\uC544 \uB098\uC654\uB2E4."
    maxAgeGap: 0
    youth: 0
  lightPasts:
  - title: "\uC61B \uB3D9\uB8CC"
    hint: "\uC608\uC804\uC5D0 \uAC19\uC740 \uACF3\uC5D0\uC11C \uC7A0\uAE50 \uD568\uAED8
      \uC77C\uD588\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uB3D9\uCC3D"
    hint: "\uAC19\uC740 \uD559\uAD50\uB97C \uB2E4\uB154\uB2E4."
    maxAgeGap: 2
    youth: 1
  - title: "\uC774\uC6C3"
    hint: "\uD55C\uB3D9\uC548 \uAC19\uC740 \uB3D9\uB124\uC5D0 \uC0B4\uC558\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uB2E8\uACE8"
    hint: "\uD55C \uC0AC\uB78C\uC774 \uB2E4\uB978 \uC0AC\uB78C\uC758 \uAC00\uAC8C\uB098
      \uC77C\uD130\uC758 \uB2E8\uACE8\uC774\uC5C8\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uBA3C \uCE5C\uCC99"
    hint: "\uBA85\uC808\uC5D0 \uBA87 \uBC88 \uC5BC\uAD74\uC744 \uBCF8 \uBA3C \uCE5C\uCC99\uC774\uB2E4."
    maxAgeGap: 0
    youth: 0
  - title: "\uC5EC\uD589\uC9C0 \uC778\uC5F0"
    hint: "\uC608\uC804\uC5D0 \uC5B4\uB290 \uC5EC\uD589\uC9C0\uC5D0\uC11C \uD558\uB8E8\uB97C
      \uD568\uAED8 \uBCF4\uB0C8\uB2E4."
    maxAgeGap: 0
    youth: 0
