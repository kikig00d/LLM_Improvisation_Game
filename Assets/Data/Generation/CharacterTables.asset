  ageRange: {x: 22, y: 65}
  childhoods:
  - title: "\uC0B0\uACE8 \uC544\uC774"
    story: "\uAE4A\uC740 \uC0B0\uACE8 \uB9C8\uC744\uC5D0\uC11C \uC790\uB77C \uB208\uACFC
      \uCD94\uC704\uC5D0 \uC775\uC219\uD558\uB2E4."
    speechHint: "\uC2DC\uACE8 \uC0AC\uD22C\uB9AC\uAC00 \uC870\uAE08 \uC11E\uC778\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uBCF4\uC721\uC6D0 \uC544\uC774"
    story: "\uBCF4\uC721\uC6D0\uC5D0\uC11C \uC790\uB77C \uB208\uCE58\uC640 \uC0B4\uC544\uB0A8\uB294
      \uBC95\uC744 \uBA3C\uC800 \uBC30\uC6E0\uB2E4."
    speechHint: "\uB9D0\uB05D\uC5D0 \uACBD\uACC4\uC2EC\uC774 \uBB3B\uC5B4\uB09C\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uBD80\uC7A3\uC9D1 \uB9C9\uB0B4"
    story: "\uBD80\uC871\uD568 \uC5C6\uC774 \uC790\uB77C \uB0A8\uC758 \uC0AC\uC815\uC744
      \uC798 \uBAA8\uB978\uB2E4."
    speechHint: "\uCC98\uC74C \uBCF4\uB294 \uC0AC\uB78C\uC5D0\uAC8C\uB3C4 \uBC18\uB9D0\uC774
      \uC27D\uAC8C \uB098\uC628\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uB9D0 \uBABB \uD558\uB358 \uC544\uC774"
    story: "\uC5B4\uB9B4 \uC801 \uD070 \uCDA9\uACA9\uC73C\uB85C \uBA87 \uB144 \uB3D9\uC548
      \uB9D0\uC744 \uBABB \uD588\uB2E4."
    speechHint: "\uB9D0\uC744 \uC544\uB07C\uACE0 \uC790\uC8FC \uBA38\uBB47\uAC70\uB9B0\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uC6B4\uB3D9\uBD80 \uC544\uC774"
    story: "\uC6B4\uB3D9\uBD80\uC5D0\uC11C \uC704\uC544\uB798\uC640 \uBAB8 \uC4F0\uB294
      \uBC95\uC744 \uBC30\uC6E0\uB2E4."
    speechHint: "\uC9E7\uACE0 \uB2E8\uD638\uD558\uAC8C \uB9D0\uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uCC45\uBC8C\uB808"
    story: "\uCE5C\uAD6C \uB300\uC2E0 \uCC45\uACFC \uC9C0\uB0C8\uB2E4."
    speechHint: "\uC544\uB294 \uCCB4\uB97C \uD558\uBA70 \uC124\uBA85\uD558\uB824
      \uB4E0\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uBC14\uB2F7\uAC00 \uC544\uC774"
    story: "\uC5B4\uCD0C\uC5D0\uC11C \uC790\uB77C \uB0A0\uC528\uB97C \uC77D\uC744
      \uC904 \uC548\uB2E4."
    speechHint: "\uBAA9\uC18C\uB9AC\uAC00 \uD06C\uACE0 \uD22C\uBC15\uD558\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uC18C\uB144 \uAC00\uC7A5"
    story: "\uC77C\uCC0D \uBD80\uBAA8\uB97C \uC783\uACE0 \uB3D9\uC0DD\uB4E4\uC744
      \uBA39\uC5EC \uC0B4\uB838\uB2E4."
    speechHint: "\uB098\uC774\uBCF4\uB2E4 \uC5B4\uB978\uC2A4\uB7FD\uAC8C \uB9D0\uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uBB38\uC81C\uC544"
    story: "\uC2F8\uC6C0\uACFC \uAC00\uCD9C\uC744 \uB418\uD480\uC774\uD588\uB2E4."
    speechHint: "\uB9D0\uC774 \uAC70\uCE60\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uBAA9\uC0AC\uB2D8 \uC790\uB140"
    story: "\uAD50\uD68C\uC5D0\uC11C \uC790\uB77C \uADDC\uCE59\uACFC \uCCB4\uBA74\uC744
      \uC911\uC694\uD558\uAC8C \uC5EC\uAE34\uB2E4."
    speechHint: "\uACF5\uC190\uD558\uAC8C \uB9D0\uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uC804\uD559\uC0DD"
    story: "\uC774\uC0AC\uB97C \uC790\uC8FC \uB2E4\uB140 \uAE08\uBC29 \uCE5C\uD574\uC9C0\uACE0
      \uAE08\uBC29 \uC78A\uB294\uB2E4."
    speechHint: "\uBD99\uC784\uC131 \uC788\uAC8C \uB9D0\uC744 \uAC74\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uC2DC\uC7A5\uD1B5 \uC544\uC774"
    story: "\uC2DC\uC7A5 \uC88C\uD310\uC5D0\uC11C \uC7A5\uC0AC\uB97C \uB3C4\uC6B0\uBA70
      \uCEF8\uB2E4."
    speechHint: "\uD765\uC815\uD558\uB4EF \uB9D0\uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  adulthoods:
  - title: "\uC0B0\uC7A5 \uAD00\uB9AC\uC778"
    story: "\uC774 \uC0B0\uC7A5\uC744 \uC624\uB798 \uC9C0\uCF1C \uC654\uB2E4. \uC0B0\uC7A5
      \uAD6C\uC11D\uAD6C\uC11D\uACFC \uC0B0\uAE38\uC744 \uC798 \uC548\uB2E4."
    speechHint: 
    unique: 1
    fixedArrival: "\uC774 \uC0B0\uC7A5\uC744 \uAD00\uB9AC\uD558\uBA70 \uC9C0\uB0B8\uB2E4."
  - title: "\uD68C\uC0AC\uC6D0"
    story: "\uD3C9\uBC94\uD55C \uD68C\uC0AC\uC5D0 \uB2E4\uB2C8\uBA70 \uC2E4\uC801\uC5D0
      \uCAD3\uAE34\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uC0AC\uC9C4\uC791\uAC00"
    story: "\uC0B0\uACFC \uB208\uC744 \uCC0D\uC73C\uB7EC \uB2E4\uB2CC\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uC758\uC0AC"
    story: "\uC791\uC740 \uBCD1\uC6D0\uC744 \uC6B4\uC601\uD55C\uB2E4. \uB2E4\uCE5C
      \uC0AC\uB78C\uC744 \uBCF4\uBA74 \uBAB8\uC774 \uBA3C\uC800 \uB098\uAC04\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uD615\uC0AC"
    story: "\uAC15\uB825\uACC4 \uD615\uC0AC\uB2E4. \uC9C0\uAE08\uC740 \uD734\uAC00
      \uC911\uC774\uB2E4."
    speechHint: "\uCE90\uBB3B\uB4EF\uC774 \uB9D0\uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uC694\uB9AC\uC0AC"
    story: "\uC2DD\uB2F9 \uC8FC\uBC29\uC7A5\uC73C\uB85C \uC624\uB798 \uC77C\uD588\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uB300\uD559\uC6D0\uC0DD"
    story: "\uB17C\uBB38\uC5D0 \uCAD3\uAE30\uB294 \uC5F0\uAD6C\uC0DD\uC774\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uC0AC\uC5C5\uAC00"
    story: "\uC791\uC740 \uC0AC\uC5C5\uC744 \uC5EC\uB7EC \uBC88 \uC77C\uC73C\uD0A4\uACE0
      \uB9DD\uD588\uB2E4."
    speechHint: "\uB4E3\uAE30 \uC88B\uC740 \uB9D0\uC744 \uC798 \uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uAC00\uC815\uC8FC\uBD80"
    story: "\uC624\uB7AB\uB3D9\uC548 \uC9D1\uC548\uC744 \uAFB8\uB824 \uC654\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uC0B0\uC545\uC778"
    story: "\uB192\uC740 \uC0B0\uC744 \uC5EC\uB7FF \uC624\uB978 \uB4F1\uBC18\uAC00\uB2E4."
    speechHint: 
    unique: 0
    fixedArrival: 
  - title: "\uAE30\uC790"
    story: "\uD2B9\uC885\uC744 \uCC3E\uC544\uB2E4\uB2C8\uB294 \uAE30\uC790\uB2E4."
    speechHint: "\uAD81\uAE08\uD55C \uAC83\uC744 \uBC14\uB85C \uBB3B\uB294\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uC804\uC9C1 \uAD70\uC778"
    story: "\uAD70\uC5D0\uC11C \uC624\uB798 \uBCF5\uBB34\uD558\uB2E4 \uC804\uC5ED\uD588\uB2E4."
    speechHint: "\uB2E4\uB098\uAE4C \uB9D0\uD22C\uAC00 \uB0A8\uC544 \uC788\uB2E4."
    unique: 0
    fixedArrival: 
  - title: "\uBCF4\uD5D8 \uC124\uACC4\uC0AC"
    story: "\uC0AC\uB78C\uC744 \uC124\uB4DD\uD574 \uBCF4\uD5D8\uC744 \uD310\uB2E4."
    speechHint: "\uCE5C\uD55C \uCC99\uC744 \uC798 \uD55C\uB2E4."
    unique: 0
    fixedArrival: 
  arrivalReasons:
  - "\uB4F1\uC0B0\uC744 \uD558\uB2E4 \uB208\uBCF4\uB77C\uB97C \uD53C\uD574 \uB4E4\uC5B4\uC654\uB2E4."
  - "\uC26C\uB824\uACE0 \uBBF8\uB9AC \uC608\uC57D\uD558\uACE0 \uC654\uB2E4."
  - "\uC0B0 \uC0AC\uC9C4\uC744 \uCC0D\uC73C\uB7EC \uC654\uB2E4."
  - "\uADFC\uCC98 \uAE38\uC5D0\uC11C \uCC28\uAC00 \uB208\uC5D0 \uAC07\uD600 \uAC78\uC5B4\uC654\uB2E4."
  - "\uB204\uAD70\uAC00\uC5D0\uAC8C\uC11C \uC774 \uC0B0\uC7A5\uC5D0\uC11C \uB9CC\uB098\uC790\uB294
    \uD3B8\uC9C0\uB97C \uBC1B\uACE0 \uC654\uB2E4."
  - "\uD63C\uC790 \uC0DD\uAC01\uC744 \uC815\uB9AC\uD558\uB7EC \uC654\uB2E4."
  traits:
  - name: "\uC218\uB2E4\uC7C1\uC774"
