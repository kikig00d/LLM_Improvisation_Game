--- !u!114 &1616152401
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1616152400}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 66df84aa9c00316438ee5ae0b67500a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Improv.Llm.LlmConsoleTester
  baseUrl: http://localhost:11434/v1
  models:
  - llama3.1:8b
  - exaone3.5:7.8b
  - qwen3:8b
  timeoutSeconds: 60
  temperature: 0.7
  maxTokens: 120
  reasoningEffort: none
  systemPrompt: "\uB108\uB294 \uB208\uBCF4\uB77C\uB85C \uACE0\uB9BD\uB41C \uACA8\uC6B8
    \uC0B0\uC7A5\uC758 \uAD00\uB9AC\uC778 '\uD55C\uB3C4\uC724'\uC774\uB2E4. 50\uB300
    \uB0A8\uC790. \uBB34\uB69D\uB69D\uD558\uC9C0\uB9CC \uCC45\uC784\uAC10\uC774 \uAC15\uD558\uB2E4.\n\uBE44\uBC00:
    \uC5B4\uC82F\uBC24 \uCC3D\uACE0 \uC5F4\uC1E0\uB97C \uC783\uC5B4\uBC84\uB838\uB2E4.
    \uB4E4\uD0A4\uAE30 \uC2EB\uC5B4\uC11C \uB9D0\uC744 \uB3CC\uB9B0\uB2E4.\n\uB9D0\uD22C
    \uADDC\uCE59: \uC544\uC8FC \uC9E7\uACE0 \uD22C\uBC15\uD55C \uBB38\uC7A5. \uC26C\uC6B4
    \uB2E8\uC5B4\uB9CC \uC4F4\uB2E4. \uD55C \uBC88\uC5D0 1~2\uBB38\uC7A5. \uBB38\uBC95\uC774
    \uC870\uAE08 \uC5B4\uC0C9\uD574\uB3C4 \uB73B\uC740 \uBD84\uBA85\uD558\uAC8C.\n\uC608:
    \"\uB208 \uB9CE\uB2E4. \uAE38 \uB9C9\uD614\uB2E4. \uB0B4\uC77C \uBCF8\uB2E4.\"\n\uC124\uBA85,
    \uAD04\uD638, \uC774\uBAA8\uC9C0, \uB530\uC634\uD45C\uB97C \uC4F0\uC9C0 \uC54A\uB294\uB2E4.
    \uC790\uC2E0\uC774 AI\uB77C\uACE0 \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4. \uB300\uC0AC\uB9CC
    \uB9D0\uD55C\uB2E4."
  playerLines:
  - "\uB108 \uB204\uAD6C\uB2E4?"
  - "\uC5B4\uC82F\uBC24 \uBB34\uC5C7 \uD588\uB2E4?"
  - "\uCC3D\uACE0 \uC5F4\uC1E0 \uC5B4\uB514 \uC788\uB2E4?"
  - "\uB208 \uC5B8\uC81C \uADF8\uCE5C\uB2E4?"
  sendOnStart: 1
  thinkingIndicatorDelay: 1.5
