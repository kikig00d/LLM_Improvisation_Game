/* 대화 UI의 모양. 웹의 CSS와 거의 같은 문법이다. 유니티 전용 속성은 -unity- 로 시작한다. */

/* 모든 글자에 한글 글꼴(Noto Sans KR, OFL)을 쓴다. */
.layer, .window {
    -unity-font-definition: url("project://database/Assets/Fonts/NotoSansKR/NotoSansKR-Regular.otf");
}

/* ===== 말풍선 판과 말풍선 ===== */
.layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.bubble {
    position: absolute;
    max-width: 420px;
    padding: 8px 14px;
    background-color: rgba(250, 248, 240, 0.95);
    border-radius: 12px;
    color: rgb(30, 30, 36);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    /* 기준점을 말풍선 아래 가운데로 옮긴다. 그래야 C#에서 머리 위 좌표만 넣으면 된다. */
    translate: -50% -100%;
}

.bubble--thinking {
    color: rgb(110, 110, 120);
    font-size: 28px;
    -unity-font-style: bold;
}

/* ===== 대화창 ===== */
.window {
    position: absolute;
    left: 22%; right: 22%; bottom: 8px;
    padding: 10px 16px;
    background-color: rgba(16, 20, 30, 0.9);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    display: none;              /* 처음에는 숨김. C#이 flex로 바꿔서 연다 */
}

.history {
    height: 96px;
    margin-bottom: 6px;
}

.history-line {
    color: rgb(220, 224, 232);
    font-size: 20px;
    white-space: normal;
    margin-bottom: 2px;
}

.history-line--self {
    color: rgb(150, 200, 255);
}

.sentence-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.chips {
    flex-direction: row;
    flex-wrap: wrap;
}

/* 고른 단어 하나. 고칠 수 없다는 느낌이 들게 단단한 조각 모양으로 (R-015a). */
.chip {
    padding: 4px 10px;
    margin: 2px 4px 2px 0;
    background-color: rgb(60, 72, 96);
    border-radius: 6px;
    color: rgb(240, 240, 240);
    font-size: 22px;
}

.word-input {
    min-width: 200px;
    flex-grow: 1;
    font-size: 22px;
    margin: 2px 0;
}

.candidates {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    min-height: 36px;
}

.candidate {
    padding: 4px 12px;
    margin: 2px 6px 2px 0;
    font-size: 20px;
    background-color: rgb(38, 44, 58);
    color: rgb(210, 214, 222);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
}

.candidate--selected {
    background-color: rgb(235, 235, 240);
    color: rgb(20, 22, 30);
}

.hint {
    margin-top: 2px;
    font-size: 15px;
    color: rgb(140, 148, 164);
}
